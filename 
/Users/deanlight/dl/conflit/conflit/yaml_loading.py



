# %% [markdown]
# # Tagged YAML (:class:`ConflitLoader`)
#
# - ``!merge`` — deep-merge a **mapping**.
# - ``!append`` — concatenate a **sequence** onto an existing list (default override does not append).
#
# Built on ``yaml.SafeLoader`` plus the two constructors above.

# %%
from __future__ import annotations

from dataclasses import dataclass
from pathlib import Path
from typing import Any

import yaml
from juplit import test
from yaml.constructor import ConstructorError


@dataclass(frozen=True, slots=True)
class TaggedMerge:
    """YAML ``!merge`` — recursively merge ``mapping`` into the destination subtree."""

    mapping: dict[str, Any]


@dataclass(frozen=True, slots=True)
class TaggedAppend:
    """YAML ``!append`` — extend the destination list with ``sequence``."""

    sequence: list[Any]


TAG_MERGE = "!merge"
TAG_APPEND = "!append"


class ConflitLoader(yaml.SafeLoader):
    """Safe loader extended with merge/append tags."""


def _construct_merge(loader: yaml.Loader, node: yaml.Node) -> TaggedMerge:
    if not isinstance(node, yaml.MappingNode):
        raise ConstructorError(None, None, "!merge expects a mapping", node.start_mark)
    data = loader.construct_mapping(node, deep=True)
    return TaggedMerge(mapping=dict(data))


def _construct_append(loader: yaml.Loader, node: yaml.Node) -> TaggedAppend:
    if not isinstance(node, yaml.SequenceNode):
        raise ConstructorError(None, None, "!append expects a sequence", node.start_mark)
    seq = loader.construct_sequence(node, deep=True)
    return TaggedAppend(sequence=list(seq))


yaml.add_constructor(TAG_MERGE, _construct_merge, Loader=ConflitLoader)
yaml.add_constructor(TAG_APPEND, _construct_append, Loader=ConflitLoader)


def load_yaml_path(path: Path) -> Any:
    """Load YAML from *path* with :class:`ConflitLoader`."""
    with open(path, encoding="utf-8") as fh:
        return yaml.load(fh, Loader=ConflitLoader)


def load_yaml_text(text: str) -> Any:
    """Parse a snippet (CLI values, snippets) — supports ``!merge`` / ``!append``."""
    return yaml.load(text, Loader=ConflitLoader)


# %%
if test():
    doc = yaml.load(
        "nested: !merge\n  x: 1\ntags: !append\n  - a\n  - b\n",
        Loader=ConflitLoader,

    )


    isinstance(doc["nested"], TaggedMerge) and isinstance(doc["tags"], TaggedAppend)


if test():

    crashed = False
    try:
        yaml.load("bad: !append\n x: wrong", Loader=ConflitLoader)
    except (ConstructorError, yaml.YAMLError):
        crashed = True
    assert crashed


# %%
if test():

    lst = yaml.load("tags: !append []\n", Loader=ConflitLoader)

    assert isinstance(lst["tags"], TaggedAppend) and lst["tags"].sequence == []


